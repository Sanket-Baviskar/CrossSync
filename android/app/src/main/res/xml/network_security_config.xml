<?xml version="1.0" encoding="utf-8"?>
<!-- All traffic to the PC is TLS (pinned to the PC's certificate fingerprint in TlsHelper), and
     discovery is UDP, which this file doesn't cover, so cleartext HTTP is never needed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
