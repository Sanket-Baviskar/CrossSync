# Copy to keystore.properties (same folder) to sign release builds.
# keystore.properties is git-ignored: never commit it or the keystore itself.
#
# Create a keystore once with:
#   keytool -genkeypair -keystore crosssync-release.jks -storetype PKCS12 -alias crosssync \
#           -keyalg RSA -keysize 4096 -validity 10000
storeFile=C:/path/outside/the/repo/crosssync-release.jks
storePassword=change-me
keyAlias=crosssync
keyPassword=change-me
